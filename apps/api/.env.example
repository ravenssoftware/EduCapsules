# Copy to .env for local development. Never commit .env — it is gitignored.
# No secret belongs in this file or in .env.example; real secrets come from
# a secret manager in every non-local environment (SRS SEC-034, BE-007).

PORT=8787
NODE_ENV=development

# Database — set DATABASE_URL to run against PostgreSQL; leave it unset to
# use the SQLite (D1 stand-in) path at SQLITE_DB_PATH instead (see
# apps/api/src/db.ts and docs/database/schema-overview.md).
# DATABASE_URL=postgresql://user:pass@localhost:5432/educapsules_dev
SQLITE_DB_PATH=./educapsules.sqlite

# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`) — encrypts
# the TOTP secret at rest (mfa_factors.secret_ciphertext). Generate your own
# value for local development; never reuse the example below, and never
# commit a real one (SEC-034). Required only once MFA enrollment is used.
MFA_SECRET_ENCRYPTION_KEY=replace-with-your-own-openssl-rand--base64-32-output
